rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS DE AUTORIZACIÓN Y PRIVILEGIOS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'lpx4NLEEMkeh9EJFcG68oPMVdXF2' ||
        (request.auth.token != null && (
          request.auth.token.superadmin == true ||
          request.auth.token.email == 'juanes9802@gmail.com' ||
          request.auth.token.email == 'elcocalombiano1828@gmail.com'
        ))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDbAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'ADMIN';
    }

    function isAdmin() {
      return isSuperAdmin() ||
        (isAuthenticated() && request.auth.token != null && request.auth.token.role == 'admin') ||
        isDbAdmin();
    }

    function isSupportAgent() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().get('status', '') == 'ACTIVE' &&
         getUserData().get('permissions', null) != null &&
         getUserData().permissions.get('supportAgent', false) == true)
      );
    }

    function isUserActive() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'ACTIVE';
    }

    function isValidUserDataOnCreate() {
      let userData = getUserData();
      return request.resource.data.userUid == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userCode == userData.userCode &&
        request.resource.data.userName == userData.fullName;
    }

    // =========================================================================
    // 1. PERFILES DE USUARIO (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if false; // Creación exclusiva por Cloud Functions Callables
      // Edición del usuario restringida a campos de perfil CLIENT_EDITABLE_USER_FIELDS
      // Edición del administrador prohíbe tocar campos financieros SERVER_AUTHORITATIVE_USER_FIELDS
      allow update: if (isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'tradeNotificationAlias', 'email', 'phone', 'paymentMethod', 'paymentDetails', 'documentId'
        ])
      ) || (isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'currentCapital', 'category', 'baseCapital', 'entryCycleId', 'role',
          'status', 'userPercentage', 'adminPercentage', 'userCode', 'createdAt',
          'entryDate', 'isClaimed', 'claimedAt', 'migrationStatus', 'permissions'
        ])
      );
      allow delete: if false; // Requiere migración a Callable que elimine Firebase Auth + Firestore

      // Subcolección de Tokens FCM por Dispositivo
      match /pushTokens/{tokenId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow create, update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      }
    }

    // =========================================================================
    // 2. RESULTADOS Y LIQUIDACIONES INDIVIDUALES (/cycleUserResults/{resultId})
    // =========================================================================
    match /cycleUserResults/{resultId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userUid == request.auth.uid
      );
      allow write: if false; // DENY TOTAL CLIENT-SIDE WRITE
    }

    // =========================================================================
    // 3. OPERACIONES DIARIAS Y BITÁCORAS DE TRADING (/dailyOperations)
    // =========================================================================
    match /dailyOperations/{docId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          (resource.data.authorizedUids != null && request.auth.uid in resource.data.authorizedUids) ||
          (resource.data.isPublicToActiveUsers == true && isUserActive())
        )
      );
      allow create, update, delete: if false;
    }

    match /bitacoras/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 4. CICLOS MENSUALES (/monthlyCycles/{cycleId})
    // =========================================================================
    match /monthlyCycles/{cycleId} {
      allow read: if isAuthenticated();
      allow write: if false; // DENY TOTAL CLIENT-SIDE WRITE
    }

    // =========================================================================
    // 5. CÁLCULOS DE GRUPO Y RESÚMENES FINANCIEROS (EXCLUSIVO ADMIN EN LECTURA)
    // =========================================================================
    match /cycleGroupCalculations/{groupId} {
      allow read: if isAdmin();
      allow write: if false; // DENY TOTAL CLIENT-SIDE WRITE
    }

    match /cycleFinancialSummaries/{cycleId} {
      allow read: if isAdmin();
      allow write: if false; // DENY TOTAL CLIENT-SIDE WRITE
    }

    // =========================================================================
    // 6. AUDITORÍA Y TRAZABILIDAD (EXCLUSIVO SUPERADMIN)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 6B. AJUSTES DE CAPITAL EN CICLO ACTIVO (/capitalAdjustments/{adjustmentId})
    // =========================================================================
    match /capitalAdjustments/{adjustmentId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userUid == request.auth.uid
      );
      allow create, update, delete: if false; // Solo Cloud Functions autoritativas
    }

    // =========================================================================
    // 7. SOLICITUDES DE REINVERSIÓN (/reinvestments/{reqId})
    // =========================================================================
    match /reinvestments/{reqId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userUid == request.auth.uid
      );
      // Las solicitudes de reinversión se crean, resuelven y aplican exclusivamente mediante
      // Cloud Functions autoritativas con el Admin SDK (submitReinvestmentRequestCallable,
      // adminResolveReinvestmentCallable, adminCloseCycleCallable).
      // Se prohíbe toda mutación directa (create, update, delete) desde clientes web o móviles.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 8. SOLICITUDES DE DESEMBOLSO / RETIRO (/disbursements/{reqId})
    // =========================================================================
    match /disbursements/{reqId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (resource.data.userUid == request.auth.uid || resource.data.userId == request.auth.uid)
      );
      allow write: if false; // DENY TOTAL CLIENT-SIDE WRITE (Exclusivo de Backend)
    }

    // =========================================================================
    // 8B. LLAVES DE IDEMPOTENCIA (/idempotencyKeys/{keyId})
    // =========================================================================
    match /idempotencyKeys/{keyId} {
      allow read, write: if false; // DENY TOTAL CLIENT-SIDE
    }

    // =========================================================================
    // 9. SOLICITUDES DE INVERSIÓN / APORTES (/investments/{invId})
    // =========================================================================
    match /investments/{invId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userUid == request.auth.uid
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        isValidUserDataOnCreate() &&
        request.resource.data.keys().hasOnly([
          'id', 'userId', 'userUid', 'userCode', 'userName', 'requestedAmountCop',
          'paymentMethod', 'status', 'createdAt', 'notes'
        ]) &&
        request.resource.data.keys().hasAll([
          'id', 'userId', 'userUid', 'userCode', 'userName', 'requestedAmountCop',
          'status', 'createdAt'
        ]) &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.requestedAmountCop is number &&
        request.resource.data.requestedAmountCop > 0
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. NOTIFICACIONES PERSONALES Y TARGETED (/notifications/{notifId})
    // =========================================================================
    match /notifications/{notifId} {
      function ownsNotification() {
        return isAuthenticated() && (
          (resource.data.userUid != null && resource.data.userUid == request.auth.uid) ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid)
        );
      }

      allow read: if isAdmin() || (
        isAuthenticated() && (
          ownsNotification() ||
          (
            resource.data.targetUids != null &&
            request.auth.uid in resource.data.targetUids
          )
        )
      );

      allow update: if isAdmin() || (
        ownsNotification() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'isRead',
            'readAt',
            'hiddenByUser',
            'hiddenAt'
          ])
      );

      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 10.1 COMUNICADOS OFICIALES (/announcements/{announcementId})
    // Escritura exclusiva por Cloud Functions (Admin SDK).
    // Los inversionistas activos solo pueden leer comunicados globales o
    // aquellos donde su UID esté explícitamente autorizado.
    // =========================================================================
    match /announcements/{announcementId} {
      allow read: if isSuperAdmin() || (
        isUserActive() && (
          resource.data.isPublicToActiveUsers == true ||
          (
            resource.data.authorizedUids != null &&
            request.auth.uid in resource.data.authorizedUids
          )
        )
      );

      allow create, update, delete: if false;
    }

    // =========================================================================
    // 10.2 ESTADO DE LECTURA DE COMUNICADOS (/announcementReads/{readId})
    // Cada inversionista controla únicamente su propio recibo de lectura.
    // =========================================================================
    match /announcementReads/{readId} {
      function ownsAnnouncementRead() {
        return isAuthenticated() &&
          resource.data.userUid == request.auth.uid;
      }

      allow read: if isSuperAdmin() || ownsAnnouncementRead();

      allow create: if isUserActive() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.announcementId is string &&
        request.resource.data.announcementId.size() > 0 &&
        readId == request.auth.uid + '_' + request.resource.data.announcementId;

      allow update: if isUserActive() &&
        ownsAnnouncementRead() &&
        request.resource.data.userUid == resource.data.userUid &&
        request.resource.data.announcementId == resource.data.announcementId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['readAt', 'updatedAt']);

      allow delete: if false;
    }

    // =========================================================================
    // 11. POSTULACIONES DE ASPIRANTES (/investorApplications/{appId})
    // =========================================================================
    match /investorApplications/{appId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 12. COLECCIONES LEGACY (ACCESO EXCLUSIVO SUPERADMIN / NO WRITE CLIENTE)
    // =========================================================================
    match /applications/{appId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /reinvestmentRequests/{reqId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 13. CONFIGURACIÓN GENERAL DEL SISTEMA (/settings/{docId})
    // =========================================================================
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() &&
        !(request.resource.data.keys().hasAny(['activeCycleId', 'operationalCycleId', 'preparingCycleId']));
      allow update: if isAdmin() &&
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeCycleId', 'operationalCycleId', 'preparingCycleId']));
      allow delete: if false;
    }

    // =========================================================================
    // 14. INFORMES OFICIALES DE CIERRE POR CICLO (/cycleReports/{cycleId}/...)
    // Acceso EXCLUSIVO para SuperAdmin (Read-Only cliente; escrituras solo backend)
    // =========================================================================
    match /cycleReports/{cycleId} {
      allow read: if isSuperAdmin();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if isSuperAdmin();
        allow write: if false;

        match /users/{userUid} {
          allow read: if isSuperAdmin();
          allow write: if false;
        }
      }
    }

    // =========================================================================
    // 15. COLECCIONES INTERNAS Y CONTADORES BACKEND-ONLY (SDK CLIENTE BLOQUEADO)
    // =========================================================================
    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /claimOperations/{opId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 16. MÓDULO DE SOPORTE TÉCNICO (FASES S1, S2, S3)
    // Mutaciones 100% exclusivas por Cloud Functions autoritativas.
    // =========================================================================
    match /supportTickets/{ticketId} {
      allow get: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid || isSupportAgent()
      );
      allow list: if isAuthenticated() && (
        resource.data.createdByUid == request.auth.uid || isSupportAgent()
      );
      allow create, update, delete: if false;

      // Subcolección de mensajes públicos
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.createdByUid == request.auth.uid ||
          isSupportAgent()
        );
        allow create, update, delete: if false;
      }

      // Subcolección de notas internas (Exclusivo Soporte / SuperAdmin - DENY TOTAL USUARIO)
      match /internalNotes/{noteId} {
        allow read: if isSupportAgent();
        allow create, update, delete: if false;
      }
    }

    // =========================================================================
    // 17. DEFAULT DENY PARA CUALQUIER OTRA COLECCIÓN O RUTA NO ESPECIFICADA
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
